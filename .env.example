# Environment variables for Vercel Project Settings (Settings -> Environment Variables)
# None of these are required to build the app, but they activate the triple-backup sync:

# 1. Telegram Bot Notifications (creates alerts on phone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Google Sheets Webhook URL (from Google Apps Script)
GOOGLE_SHEETS_WEBHOOK_URL=

# 3. Vercel KV (automatically added when you click Storage -> Create KV in Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 4. Optional Backup Webhook
VERCEL_BACKUP_WEBHOOK_URL=
